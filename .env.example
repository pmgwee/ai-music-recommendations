NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# SP-0 only — server GLM key (BYOK replaces this in SP-2)
ZAI_API_KEY=
ZAI_BASE_URL=
GLM_MODEL=
# SP-2 BYOK — root key for AES-256-GCM of user LLM API keys (user_llm_keys).
# Also used by SP-3 to encrypt provider OAuth tokens (provider_tokens) and to
# HMAC-sign the PKCE cookie. Generate with: openssl rand -hex 32
# (32 bytes → 64 hex chars). SERVER ONLY.
LLM_KEY_ENCRYPTION_KEY=
# SP-3 playlist ingestion — provider OAuth client credentials. Register an
# OAuth client at each provider's developer console. Empty by default; the
# connect route returns "not_configured" cleanly until both are set. SERVER ONLY.
# YouTube (Google Cloud Console → APIs & Services → Credentials; scope youtube.readonly):
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=
# Spotify (Spotify Developer Dashboard → Apps; scope playlist-read-private):
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=
